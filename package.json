{
  "name": "sensor-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard de lecturas de sensores (DynamoDB) publicado con GitHub Pages",
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/run.mjs",
    "import": "node scripts/import-json.mjs",
    "live": "node scripts/dev-server.mjs",
    "fetch": "node scripts/fetch.mjs",
    "serve": "node scripts/serve.mjs",
    "mock": "node scripts/mock-api.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0"
  }
}
